# More info: https://docs.docker.com/engine/reference/builder/dockerignore-file
**

# Root module: Go source (not *_test.go) + module files
!cmd
!api
!internal
!**/*.go
**/*_test.go
!go.mod
!go.sum

# Runner module (S3): separate module, built by cmd/runner/Dockerfile
!runner
!runner/cmd
!runner/testhelper
!runner/go.mod
!runner/go.sum
!runner/runner.go
!runner/cmd/*.go
!runner/testhelper/*.go
