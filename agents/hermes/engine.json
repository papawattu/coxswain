{
  "name": "hermes",
  "command": [
    "/opt/hermes/.venv/bin/hermes",
    "-z",
    "${COX_PROMPT}",
    "--yolo",
    "-t",
    "terminal,file,code_execution,todo"
  ],
  "env": {
    "HERMES_HOME": "${HOME}/hermes",
    "HERMES_WRITE_SAFE_ROOT": "${COX_WORKSPACE}",
    "XDG_RUNTIME_DIR": "/tmp/hermes-runtime",
    "OPENAI_API_KEY": "unused",
    "HERMES_DISABLE_LAZY_INSTALLS": "1",
    "HERMES_DISABLE_MODEL_METADATA_FETCH": "1",
    "HERMES_DISABLE_TELEMETRY": "1",
    "HERMES_DISABLE_PLUGINS": "1"
  },
  "files": [
    {
      "path": "${HOME}/hermes/config.yaml",
      "content": "_config_version: 54\nmodel:\n  default: \"${COX_MODEL}\"\n  provider: \"custom\"\n  base_url: \"${COX_MODEL_BASE_URL}/v1\"\n  api_key: \"unused\"\nsecurity:\n  allow_lazy_installs: false\nplugins:\n  auto_update_check_hours: 0\nlsp:\n  enabled: false\ncurator:\n  enabled: false\nmodel_catalog:\n  enabled: false\n"
    },
    {
      "path": "${HOME}/hermes/cache/plugin-catalog.json",
      "content": "{\"entries\": [], \"removed\": []}"
    },
    {
      "path": "${HOME}/hermes/cache/reasoning_caps.json",
      "content": "{\"https://openrouter.ai/api/v1/models\": {\"ts\": 4102444800, \"caps\": {\"coxswain-placeholder\": null}}}"
    }
  ]
}
