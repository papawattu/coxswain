@@ -0,0 +1,20 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// roundJSON renders the task 2 -json output: a single-line JSON object with
+// the input value, the requested places, and the rounded result.
+func roundJSON(value float64, places int) (string, error) {
+	b, err := json.Marshal(map[string]any{
+		"value":   value,
+		"places":  places,
+		"rounded": Round(value, places),
+	})
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%s", b), nil
+}
