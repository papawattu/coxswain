+
+def median(values):
+    """Median; averages the middle pair for even length; does not mutate input."""
+    if not values:
+        raise ValueError("median of empty sequence")
+    data = sorted(values)
+    n = len(data)
+    mid = n // 2
+    if n % 2:
+        return data[mid]
+    return (data[mid - 1] + data[mid]) / 2
+
+
+# Median is the public name the acceptance tests import.
+Median = median
+
+
+def clamp(value, low, high):
+    """Clamp value into [low, high]."""
+    if low > high:
+        raise ValueError("low must be <= high")
+    return max(low, min(value, high))
+
+
+# Clamp is the public name the acceptance tests import.
+Clamp = clamp
