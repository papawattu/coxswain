diff --git a/main.go b/main.go
index 38cf674..01a89ec 100644
--- a/main.go
+++ b/main.go
@@ -2,6 +2,7 @@ package main
 
 import (
 	"fmt"
+	"io"
 	"net/http"
 	"os"
 	"strconv"
@@ -13,6 +14,8 @@ import (
 func main() {
 	mux := http.NewServeMux()
 	mux.HandleFunc("/healthz", healthz)
+	mux.HandleFunc("/api/v1/ping", ping)
+	mux.HandleFunc("/api/v1/echo", echo)
 
 	port := os.Getenv("PORT")
 	if port == "" {
@@ -34,3 +37,20 @@ func healthz(w http.ResponseWriter, _ *http.Request) {
 	w.WriteHeader(http.StatusOK)
 	fmt.Fprint(w, "ok")
 }
+
+
+func ping(w http.ResponseWriter, _ *http.Request) {
+	w.WriteHeader(http.StatusOK)
+	fmt.Fprint(w, "pong")
+}
+
+
+func echo(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+	w.Header().Set("Content-Type", "application/json")
+	io.Copy(w, r.Body)
+}
diff --git a/test/smoke.sh b/test/smoke.sh
index 468211e..3d62ac4 100644
--- a/test/smoke.sh
+++ b/test/smoke.sh
@@ -59,6 +59,17 @@ else
 fi
 
 # Task 2: /api/v1/echo mirrors the request body back as JSON.
-# The seed state has no echo route; the check is added to this script by
-# tasks/2.patch together with the route itself.
+resp=$(curl -sf -X POST -H 'Content-Type: application/json' \
+  -d '{"hello":"world"}' \
+  "http://127.0.0.1:$PORT/api/v1/echo" 2>/dev/null || true)
+code=$(curl -s -o /dev/null -w '%{http_code}' -X POST \
+  -H 'Content-Type: application/json' -d '{"hello":"world"}' \
+  "http://127.0.0.1:$PORT/api/v1/echo" 2>/dev/null || echo 000)
+if [ "$code" = "200" ] && printf '%s' "$resp" | grep -q '"hello":"world"'; then
+  echo "echo: PASS"
+else
+  echo "echo: FAIL (code=$code body=${resp:-<empty>})"
+  FAIL=1
+fi
+
 exit "$FAIL"
